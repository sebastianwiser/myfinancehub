# Copy to .env (gitignored). Placeholder values only.
TELEGRAM_BOT_TOKEN=your-bot-token
# Filled in by `mainhub telegram-pair`; only this chat can send receipts.
TELEGRAM_ALLOWED_CHAT_ID=
# Local vision model served by Ollama (must support images).
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_HOST=http://localhost:11434
MAINHUB_DB_PATH=./data/mainhub.sqlite

# Optional personal categorization rules (see demo/categories.example.toml).
MAINHUB_CATEGORY_RULES=./categories.toml
