# Copy to .env (gitignored). Placeholder values only.
PLAID_CLIENT_ID=your-client-id
PLAID_SECRET=your-secret
PLAID_ENV=sandbox
# Comma-separated access tokens, one per linked bank (Item).
PLAID_ACCESS_TOKENS=access-sandbox-your-token
TELEGRAM_BOT_TOKEN=your-bot-token
# Filled in by `mainhub telegram-pair`; only this chat can send receipts.
TELEGRAM_ALLOWED_CHAT_ID=
# Local vision model served by Ollama (must support images).
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_HOST=http://localhost:11434
MAINHUB_DB_PATH=./data/mainhub.sqlite
